# Copia estos nombres en Vercel > Settings > Environment Variables
# NUNCA pongas tu Access Token dentro de config.js ni en otro archivo público.

# Access Token de Mercado Pago (empieza con APP_USR-). Usa primero el de PRUEBA.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx

# Dirección final de tu sitio, sin barra al final (opcional, se detecta sola)
SITE_URL=https://fructifero.vercel.app
